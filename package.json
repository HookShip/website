{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "description": "Public website for the HookShip organization.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.23.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "PAGES_BASE_PATH=/website NEXT_PUBLIC_SITE_URL=https://hookship.github.io/website next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:source": "pnpm format:check && pnpm lint",
    "check": "pnpm check:source && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.13.0"
}
